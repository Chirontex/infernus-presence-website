# ===================================================================
# Docker Compose Environment Configuration
# ===================================================================
# Copy this file to .env and adjust values for your environment.
# IMPORTANT: Never commit .env file to version control!
# ===================================================================

# -------------------------------------------------------------------
# APPLICATION ENVIRONMENT (Symfony)
# -------------------------------------------------------------------

# APP_ENV: Application environment mode
# Values: dev (development) | prod (production)
# dev: enables debugging, verbose error messages
# prod: disables debugging, optimizes performance
APP_ENV=dev

# APP_DEBUG: Enable/disable debug mode
# Values: 0 (disabled) | 1 (enabled)
# Set to 0 in production for security
APP_DEBUG=1

# APP_SECRET: Secret key for encryption and security
# Use: CSRF tokens, session encryption, password hashing
# Generate with: openssl rand -hex 32
# IMPORTANT: Change this value in production!
APP_SECRET=ChangeMe!YourSecretKey123456

# APP_SHARE_DIR: Directory for shared application data
# Relative path from project root where shared data is stored
# Used by Symfony for caching and temporary file storage
APP_SHARE_DIR=var/share

# DEFAULT_URI: Default application URI for redirects and base URLs
# Used when generating links in emails and API responses
# Should match your frontend host and protocol
DEFAULT_URI=http://infernus-presence.local

# -------------------------------------------------------------------
# DATABASE CONFIGURATION (MariaDB)
# -------------------------------------------------------------------

# DB_HOST: Database server hostname
# In Docker: use service name 'database'
# In production: use your database server hostname
DB_HOST=database

# DB_PORT: Database server port
# Default MariaDB/MySQL port is 3306
DB_PORT=3306

# DB_NAME: Database name to create and use
# The application will store all data in this database
DB_NAME=infernus_db

# DB_USER: Application database user
# This user will have access to DB_NAME database
# IMPORTANT: Change from default in production!
DB_USER=infernus_user

# DB_PASSWORD: Password for DB_USER
# Used by backend application to connect to database
# IMPORTANT: Use strong password in production!
DB_PASSWORD=infernus_password

# DB_ROOT_PASSWORD: Root user password for MariaDB
# Root user has full database access and control
# IMPORTANT: Change from default in production!
DB_ROOT_PASSWORD=root

# DATABASE_URL: Full DSN (Data Source Name) for database connection
# Used by Doctrine ORM for connecting to the database
# Format: mysql://user:password@host:port/dbname?options
# serverVersion: specify MariaDB/MySQL version for compatibility
# charset: utf8mb4 supports full Unicode including emojis
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=12-MariaDB&charset=utf8mb4"

# -------------------------------------------------------------------
# FRONTEND CONFIGURATION (Node.js / Nuxt)
# -------------------------------------------------------------------

# FRONTEND_HOST: Frontend application hostname
# Used for browser access and CORS configuration
# Examples: localhost, 127.0.0.1, infernus-presence.local, yourdomain.com
FRONTEND_HOST=infernus-presence.local

# FRONTEND_PORT: Frontend development server port
# Port where Nuxt dev server listens
# Make sure this port is not in use
FRONTEND_PORT=3000

# NODE_ENV: Node.js environment mode
# Values: development | production
# development: enables HMR (Hot Module Reload), verbose logging
# production: optimizes performance, disables debugging
NODE_ENV=development

# NUXT_PUBLIC_API_BASE: Backend API base URL
# Frontend uses this to call backend API
# Include protocol (http/https) and path
# In production: use your backend API domain
NUXT_PUBLIC_API_BASE=http://infernus-presence.local/api

# -------------------------------------------------------------------
# BACKEND API CONFIGURATION (Symfony / CORS)
# -------------------------------------------------------------------

# CORS_ALLOW_ORIGIN: CORS allowed origin pattern (regex)
# Controls which domains can make requests to backend API
# Format: regex pattern matching allowed origins
# ^https?:// - allows http and https
# (domain1|domain2) - multiple domains separated by |
# Update this for your production domain(s)
CORS_ALLOW_ORIGIN=^https?://(localhost|127.0.0.1|infernus-presence.local)(:[0-9]+)?$

# -------------------------------------------------------------------
# HTTP SERVER CONFIGURATION (nginx)
# -------------------------------------------------------------------

# HTTP_PORT: HTTP server port
# Standard HTTP port is 80
# On Linux, ports < 1024 require root/sudo
# You can use 8080 or higher to run without special permissions
HTTP_PORT=80

# HTTPS_PORT: HTTPS server port
# Standard HTTPS port is 443
# Requires SSL certificates configured in nginx
# On Linux, ports < 1024 require root/sudo
HTTPS_PORT=443

# -------------------------------------------------------------------
# OPTIONAL CONFIGURATIONS (for future features)
# -------------------------------------------------------------------

# MAILER_DSN: Email service configuration
# Needed if implementing email notifications
# Examples: smtp://user:pass@smtp.example.com:587
# Or: sendgrid+api://key@default
MAILER_DSN=smtp://localhost

# MESSENGER_TRANSPORT_DSN: Message queue/transport configuration
# Used by Symfony Messenger for async message processing
# Options:
#   - doctrine://default?auto_setup=0 - uses database (configured)
#   - amqp://guest:guest@localhost:5672/%2f/messages - RabbitMQ transport
#   - redis://localhost:6379/messages - Redis transport
# Selected transport handles queued jobs and async tasks
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# JWT_SECRET_KEY: Path to JWT private key file
# Used for JWT token signing in authentication
# Generate with: openssl genrsa -out private.pem 4096
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem

# JWT_PUBLIC_KEY: Path to JWT public key file
# Used for JWT token verification
# Generate from private key: openssl rsa -in private.pem -pubout -out public.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# JWT_PASSPHRASE: Passphrase for JWT private key
# Used when private key is encrypted
# IMPORTANT: Change in production!
JWT_PASSPHRASE=YourJWTPassphrase123456
